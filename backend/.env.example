# Copy to .env and start the backend with: uvicorn main:app --env-file .env
# Every value below is optional. These are the defaults.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
MNEMO_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MNEMO_DATA_DIR=./data
MNEMO_MAX_UPLOAD_MB=20
MNEMO_TOP_K=4
# Passages below this cosine similarity are ignored. Recall refuses when none are left.
MNEMO_MIN_SIMILARITY=0.35
MNEMO_EMBED_MODEL=all-MiniLM-L6-v2
MNEMO_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
# Entailment probability a sentence needs to count as supported.
MNEMO_NLI_THRESHOLD=0.5
